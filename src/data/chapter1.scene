# Scènes du chapitre 1. Noms et répliques provisoires, le temps de définir l'univers.
# Chaque réplique est une clé : le texte se trouve dans src/i18n/story.fr.json.

@event intro quand chapitre.debut
  @montre anna gauche
  @montre marc droite
  anna: ch1.intro.1
  marc: ch1.intro.2
  anna: ch1.intro.3
  @montre lise droite
  lise: ch1.intro.4
  @cache marc
  anna: ch1.intro.5

@event victoire quand chapitre.victoire
  @montre anna gauche
  @montre marc droite
  anna: ch1.victoire.1
  marc: ch1.victoire.2

@event defaite quand chapitre.defaite
  @montre marc gauche
  marc: ch1.defaite.1
