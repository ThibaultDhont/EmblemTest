# Dialogues du chapitre 1. Noms et répliques provisoires, le temps de définir l'univers.
# Chaque réplique est une clé : le texte se trouve dans src/i18n/story.fr.json.

@event intro quand chapitre.debut
  @montre anna gauche
  @montre marc droite
  anna: ch1.intro.1
  marc: ch1.intro.2
  anna: ch1.intro.3
  @montre lise droite
  lise: ch1.intro.4
  anna: ch1.intro.5
  marc: ch1.choix.question
  # Le choix du joueur ne fait que poser un drapeau, que d'autres dialogues relisent plus tard.
  @choix
    @option ch1.choix.fonce
      @drapeau audacieux
      marc: ch1.choix.fonce.reponse
    @option ch1.choix.observe
      @drapeau prudent
      marc: ch1.choix.observe.reponse
  @fin

# Mini-tutoriel : la première fois qu'on sélectionne Anna (voix neutre, pour ne dépendre de personne).
@event tuto-selection quand selection(anna)
  narration: ch1.tuto.selection

# Premier ordre d'attaque contre le lancier e2 : le dialogue passe avant que le combat se joue.
@event premiere-attaque-lancier quand attaque(e2)
  @montre anna gauche
  anna: ch1.attaque.e2

# Une unité qui s'arrête dans l'enclos de pierre y trouve une cachette.
@event cachette quand case(6,7)
  narration: ch1.cachette.1

# Au début de la phase ennemie du tour 2, tant que le boss est debout.
@event pressentiment quand tour.ennemi(2)
  @montre marc droite
  @si vivant(brutus)
    marc: ch1.pressentiment.1
  @fin

# Au début du tour 3, la réplique dépend de ce qui est arrivé au lancier.
@event point-tour3 quand tour.joueur(3)
  @montre marc gauche
  @si mort(e2)
    marc: ch1.tour3.mort
  @sinon
    marc: ch1.tour3.vivant
  @fin
  @si drapeau(prudent)
    marc: ch1.tour3.prudent
  @sinon
    marc: ch1.tour3.audacieux
  @fin

# Mise en scène : un archer arrive par l'est au début de la phase ennemie du tour 3, puis avance.
@event renforts quand tour.ennemi(3)
  @montre anna gauche
  anna: ch1.renforts.1
  @apparait e4 23 8
  @deplace e4 21 9
  anna: ch1.renforts.2
  anna: ch1.renforts.3
  # Le nouvel objectif remplace « vaincre le boss » : il suffit désormais de tenir jusqu'à la fin du tour 4.
  @objectif survie 4

# Au tour 4, un mercenaire propose ses services : accepter le fait passer dans le camp du joueur.
@event mercenaire quand tour.joueur(4)
  @si vivant(rik)
    @montre rik droite
    rik: ch1.rik.1
    @choix
      @option ch1.rik.payer
        @recrute rik
        rik: ch1.rik.accepte
      @option ch1.rik.refuser
        rik: ch1.rik.refuse
    @fin
  @fin

# Quand Lise tombe : le drapeau sert à changer le dialogue de victoire.
@event adieu-lise quand mort(lise)
  @montre anna gauche
  anna: ch1.lise.1
  @drapeau lise-morte

@event dernier-mot-du-boss quand mort(brutus)
  @montre brutus droite
  brutus: ch1.brutus.1

@event victoire quand chapitre.victoire
  @montre anna gauche
  @montre marc droite
  anna: ch1.victoire.1
  @si drapeau(lise-morte)
    marc: ch1.victoire.triste
  @sinon
    marc: ch1.victoire.2
  @fin

@event defaite quand chapitre.defaite
  @montre marc gauche
  marc: ch1.defaite.1
