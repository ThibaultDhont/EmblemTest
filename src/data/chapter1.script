# Dialogues du chapitre 1. Noms et répliques provisoires, le temps de définir l'univers.
# Chaque réplique est une clé : le texte se trouve dans src/i18n/story.fr.json.

@event intro quand chapitre.debut
  @montre anna gauche
  @montre marc droite
  anna: ch1.intro.1
  marc: ch1.intro.2
  anna: ch1.intro.3
  @montre lise droite
  lise: ch1.intro.4
  anna: ch1.intro.5
  marc: ch1.choix.question
  # Le choix du joueur ne fait que poser un drapeau, que d'autres dialogues relisent plus tard.
  @choix
    @option ch1.choix.fonce
      @drapeau audacieux
      marc: ch1.choix.fonce.reponse
    @option ch1.choix.observe
      @drapeau prudent
      marc: ch1.choix.observe.reponse
  @fin

# Mini-tutoriel : la première fois qu'on sélectionne Anna (voix neutre, pour ne dépendre de personne).
@event tuto-selection quand selection(anna)
  narration: ch1.tuto.selection

# Premier ordre d'attaque contre le lancier Gus : le dialogue passe avant que le combat se joue.
@event premiere-attaque-lancier quand attaque(gus)
  @montre anna gauche
  anna: ch1.attaque.e2

# Une unité qui s'arrête dans l'enclos de pierre y trouve une cachette.
@event cachette quand case(6,7)
  narration: ch1.cachette.1

# « Parler » : une conversation entre Anna et Marc, quand Anna s'arrête à côté de lui. Sans effet sur la partie.
@event anna-marc quand parler(anna,marc)
  @montre anna gauche
  @montre marc droite
  anna: ch1.parler.anna-marc.1
  marc: ch1.parler.anna-marc.2

# Recrutement par la parole : Anna au contact de Gus le fait passer de son côté.
@event recruter-gus quand parler(anna,gus)
  @montre anna gauche
  @montre gus droite
  anna: ch1.parler.gus.1
  gus: ch1.parler.gus.2
  anna: ch1.parler.gus.3
  @recrute gus
  @drapeau gus-recrute
  gus: ch1.parler.gus.4

# Au début de la phase ennemie du tour 2, tant que le boss est debout.
@event pressentiment quand tour.ennemi(2)
  @montre marc droite
  @si vivant(brutus)
    marc: ch1.pressentiment.1
  @fin

# Au début du tour 3, la réplique dépend de ce qui est arrivé au lancier : recruté, vaincu, ou toujours là.
@event point-tour3 quand tour.joueur(3)
  @montre marc gauche
  @si drapeau(gus-recrute)
    marc: ch1.tour3.gus
  @sinon
    @si mort(gus)
      marc: ch1.tour3.mort
    @sinon
      marc: ch1.tour3.vivant
    @fin
  @fin
  @si drapeau(prudent)
    marc: ch1.tour3.prudent
  @sinon
    marc: ch1.tour3.audacieux
  @fin

# Mise en scène : un archer arrive par l'est au début de la phase ennemie du tour 3, puis avance.
@event renforts quand tour.ennemi(3)
  @montre anna gauche
  anna: ch1.renforts.1
  @apparait e4 31 8
  @deplace e4 21 9
  anna: ch1.renforts.2
  # Le nouvel objectif remplace « vaincre le boss » et dépend du choix du début :
  # tenir la position jusqu'à la fin du tour 4, ou battre en retraite vers la route en (1,14).
  @si drapeau(prudent)
    @si vivant(marc)
      anna: ch1.renforts.retraite-marc
      @objectif escorte marc 1 14
    @sinon
      anna: ch1.renforts.retraite
      @objectif atteindre 1 14
    @fin
  @sinon
    anna: ch1.renforts.3
    @objectif survie 4
  @fin

# Au tour 4, un mercenaire propose ses services : accepter le fait passer dans le camp du joueur.
@event mercenaire quand tour.joueur(4)
  @si vivant(rik)
    @montre rik droite
    rik: ch1.rik.1
    @choix
      @option ch1.rik.payer
        @recrute rik
        rik: ch1.rik.accepte
      @option ch1.rik.refuser
        rik: ch1.rik.refuse
    @fin
  @fin

# Quand Lise tombe : le drapeau sert à changer le dialogue de victoire.
@event adieu-lise quand mort(lise)
  @montre anna gauche
  anna: ch1.lise.1
  @drapeau lise-morte

@event dernier-mot-du-boss quand mort(brutus)
  @montre brutus droite
  brutus: ch1.brutus.1

@event victoire quand chapitre.victoire
  @montre anna gauche
  @montre marc droite
  anna: ch1.victoire.1
  @si drapeau(lise-morte)
    marc: ch1.victoire.triste
  @sinon
    marc: ch1.victoire.2
  @fin

@event defaite quand chapitre.defaite
  @montre marc gauche
  marc: ch1.defaite.1
